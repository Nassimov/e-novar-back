# ─── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase Storage bucket name (create in Supabase dashboard)
SUPABASE_STORAGE_BUCKET=enovar-files

# ─── Redis (Railway Redis add-on URL) ──────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Anthropic (Claude AI) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Stripe (Payments — CIB card rail) ─────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Chargily Pay (Payments — Edahabia rail) ────────────────
# Get a test key from pay.chargily.com/dashboard/developers-corner (no
# verification needed for Test Mode). Same key is used for API auth
# (Bearer) and webhook signature verification — there is no separate
# webhook secret. CHARGILY_BASE_URL defaults to their test/sandbox URL in
# app/config.py; only set it here to override (e.g. switch to the live URL
# once the account is verified for Live Mode).
CHARGILY_SECRET_KEY=test_sk_...

# ─── LiveKit (video classroom) ──────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ─── LiveKit Egress (session recording) — S3-compatible target ─
# Points at Supabase Storage's S3-compatible endpoint by default (Project
# Settings > Storage > S3 Connection in the Supabase dashboard — different
# credentials from SUPABASE_SERVICE_ROLE_KEY). Leave blank to disable
# recording (the start-recording endpoint returns a clear error until set).
EGRESS_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
EGRESS_S3_REGION=us-east-1
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET_KEY=
EGRESS_S3_BUCKET=enovar-recordings

# ─── Live classroom captions (LiveKit Agent worker) ─────────
# Only read by app/agents/transcription_agent.py — a SEPARATE long-running
# process, deployed as its own Railway service (see Procfile's `agent`
# line), not by the main web service. Reuses LIVEKIT_URL/LIVEKIT_API_KEY/
# LIVEKIT_API_SECRET above.
DEEPGRAM_API_KEY=

# ─── OneSignal (Push Notifications) ────────────────────────
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-key

# ─── Resend (Transactional Email) ──────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Enovar <noreply@enovar.dz>

# ─── Twilio (SMS) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ─── App ───────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-in-production
APP_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Vercel preview URL + production URL (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app,https://enovar.dz
